@model VolunteerMS.Models.Volunteer

@{
    ViewData["Title"] = "Create Volunteer";
}

<h2>Create Volunteer</h2>

<hr />

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <h4>Account</h4>

    <div class="mb-3">
        <label class="form-label">Username</label>

        <input name="username"
               class="form-control" />

    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>

        <input name="password"
               type="password"
               class="form-control" />

    </div>

    <hr />

    <h4>Volunteer Information</h4>

    <div class="row">

        <div class="col-md-6">

            <div class="mb-3">
                <label asp-for="FirstName"></label>

                <input asp-for="FirstName"
                       class="form-control" />

                <span asp-validation-for="FirstName"
                      class="text-danger"></span>
            </div>

        </div>

        <div class="col-md-6">

            <div class="mb-3">
                <label asp-for="LastName"></label>

                <input asp-for="LastName"
                       class="form-control" />

                <span asp-validation-for="LastName"
                      class="text-danger"></span>
            </div>

        </div>

    </div>

    <div class="mb-3">

        <label asp-for="Email"></label>

        <input asp-for="Email"
               class="form-control" />

        <span asp-validation-for="Email"
              class="text-danger"></span>

    </div>

    <div class="row">

        <div class="col-md-6">

            <div class="mb-3">

                <label asp-for="HomePhone"></label>

                <input asp-for="HomePhone"
                       class="form-control" />

            </div>

        </div>

        <div class="col-md-6">

            <div class="mb-3">

                <label asp-for="CellPhone"></label>

                <input asp-for="CellPhone"
                       class="form-control" />

            </div>

        </div>

    </div>

    <div class="mb-3">

        <label asp-for="Address"></label>

        <input asp-for="Address"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="EducationalBackground"></label>

        <textarea asp-for="EducationalBackground"
                  class="form-control">
        </textarea>

    </div>

    <div class="mb-3">

        <label asp-for="Licenses"></label>

        <textarea asp-for="Licenses"
                  class="form-control">
        </textarea>

    </div>

    <div class="mb-3">

        <label asp-for="Availability"></label>

        <textarea asp-for="Availability"
                  class="form-control">
        </textarea>

    </div>

    <hr />

    <h4>Emergency Contact</h4>

    <div class="mb-3">

        <label asp-for="EmergencyContactName"></label>

        <input asp-for="EmergencyContactName"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="EmergencyContactPhone"></label>

        <input asp-for="EmergencyContactPhone"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="EmergencyContactEmail"></label>

        <input asp-for="EmergencyContactEmail"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="EmergencyContactAddress"></label>

        <input asp-for="EmergencyContactAddress"
               class="form-control" />

    </div>

    <hr />

    <h4>Documents</h4>

    <div class="form-check">

        <input asp-for="DriverLicenseOnFile"
               class="form-check-input" />

        <label asp-for="DriverLicenseOnFile"
               class="form-check-label">
        </label>

    </div>

    <div class="form-check">

        <input asp-for="SSCardOnFile"
               class="form-check-input" />

        <label asp-for="SSCardOnFile"
               class="form-check-label">
        </label>

    </div>

    <hr />

    <h4>Centers</h4>

    <select name="selectedCenter"
            class="form-select"
            asp-items="ViewBag.Centers">
    </select>

    <hr />

    <h4>Skills</h4>

    <select name="selectedSkills"
           
            class="form-select"
            asp-items="ViewBag.Skills">
    </select>

    <hr />

    <h4>Opportunities</h4>

    <select name="selectedOpportunity"
            class="form-select"
            asp-items="ViewBag.Opportunities">
    </select>

    <hr />

    <button type="submit"
            class="btn btn-success">

        Save

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>

@section Scripts{

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}