@model VolunteerMS.Models.ViewModels.Volunteer.VolunteerSkillsVM

@{
    ViewData["Title"] = "Volunteer Skills";
}

<h2 class="mb-4">Manage Volunteer Skills</h2>

<div class="card shadow-sm">

    <div class="card-header">
        <h5 class="mb-0">@Model.VolunteerName</h5>
    </div>

    <div class="card-body">

        <form asp-action="Skills" method="post">

            <input asp-for="VolunteerId" type="hidden" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            @for (int i = 0; i < Model.Skills.Count; i++)
            {
                <input asp-for="Skills[i].SkillId" type="hidden" />
                <input asp-for="Skills[i].SkillName" type="hidden" />

                <div class="form-check mb-2">

                    <input asp-for="Skills[i].Selected"
                           class="form-check-input" />

                    <label asp-for="Skills[i].Selected"
                           class="form-check-label">

                        @Model.Skills[i].SkillName

                    </label>

                </div>
            }

            <hr />

            <button type="submit"
                    class="btn btn-primary">
                Save Skills
            </button>

            <a href="@(ViewBag.ReturnUrl ?? Url.Action(action: "Index"))"
                class="btn btn-secondary">
                Back to List
            </a>

        </form>

    </div>

</div>