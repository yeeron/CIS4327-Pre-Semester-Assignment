@model VolunteerMS.Models.ViewModels.Volunteer.VolunteerOpportunitiesVM

@{
    ViewData["Title"] = "Volunteer Opportunity Matches";
}

<h2 class="mb-4">Matched Opportunities</h2>

<div class="card shadow-sm">

    <div class="card-header">
        <h5 class="mb-0">@Model.VolunteerName
            @if(Model.IsActive){
                <span class="badge bg-success size-status-badge">Active</span>
            }else{
                <span class="badge bg-secondary size-status-badge">Inactive</span>
            }
        </h5>
        <br />

        <small class="text-muted">
            The opportunities below match the volunteer's preferred centers.<br />
            Select the opportunities you want to assign.
        </small>
    </div>

    <div class="card-body">

        @if (!Model.Opportunities.Any())
        {
            <div class="alert alert-info">
                No opportunities are available for this volunteer's preferred centers.
            </div>
            <br />
            <a asp-action="Index"
                class="btn btn-secondary">
                Back
            </a>
        }
        else
        {
            <form asp-action="Matches" method="post">

                <input asp-for="VolunteerId" type="hidden" />
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                @for (int i = 0; i < Model.Opportunities.Count; i++)
                {
                    <input asp-for="Opportunities[i].OpportunityId" type="hidden" />
                    <input asp-for="Opportunities[i].OpportunityName" type="hidden" />
                    <input asp-for="Opportunities[i].CenterName" type="hidden" />
                    <input asp-for="Opportunities[i].IsActive" type="hidden" />
                    <input asp-for="Opportunities[i].StartDate" type="hidden" />
                    <input asp-for="Opportunities[i].EndDate" type="hidden" />

                    <div class="card mb-3 shadow-sm">

                        <div class="card-body">

                            <div class="form-check">

                                <input asp-for="Opportunities[i].Selected"
                                    disabled="@(Model.Opportunities[i].IsActive == false )"
                                    class="form-check-input mt-2" />

                                <label class="form-check-label w-100">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <h5 class="mb-0">
                                            @Model.Opportunities[i].OpportunityName
                                        </h5>

                                        @if(Model.Opportunities[i].IsActive == true){
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }else{
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </div>

                                    <hr />

                                    <div class="row">

                                        <div class="col-md-6">

                                            <strong>Center</strong>

                                            <br />

                                            <span class="text-muted">
                                                @Model.Opportunities[i].CenterName
                                            </span>

                                        </div>

                                        <div class="col-md-6">

                                            <strong>Dates</strong>

                                            <br />

                                            <span class="text-muted">
                                                @Model.Opportunities[i].StartDate.ToString("MMM dd, yyyy")
                                                -
                                                @Model.Opportunities[i].EndDate.ToString("MMM dd, yyyy")
                                            </span>

                                        </div>

                                    </div>

                                </label>

                            </div>

                        </div>

                    </div>
                }

                <button type="submit" class="btn btn-primary">
                    Save Matches
                </button>

                <!--a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a> -->
                <a href="@(ViewBag.ReturnUrl ?? Url.Action(action: "Index"))"
                    class="btn btn-secondary">
                    Back
                </a>

            </form>
        }

    </div>

</div>