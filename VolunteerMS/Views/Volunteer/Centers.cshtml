@model VolunteerMS.Models.ViewModels.Volunteer.VolunteerCentersVM

@{
    ViewData["Title"] = "Volunteer Centers";
}

<h2 class="mb-4">Manage Volunteer Centers</h2>

<div class="card shadow-sm">

    <div class="card-header">
        <h5 class="mb-0">@Model.VolunteerName</h5>
    </div>

    <div class="card-body">

        <form asp-action="Centers" method="post">

            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <input asp-for="VolunteerId" type="hidden" />

            @for (int i = 0; i < Model.Centers.Count; i++)
            {
                <input asp-for="Centers[i].CenterId" type="hidden" />
                <input asp-for="Centers[i].Name" type="hidden" />

                <div class="form-check mb-2">

                    <input asp-for="Centers[i].Selected"
                           class="form-check-input" />

                    <label asp-for="Centers[i].Selected"
                           class="form-check-label">

                        @Model.Centers[i].Name

                    </label>

                </div>
            }

            <hr />

            <button type="submit"
                    class="btn btn-primary">
                Save Centers
            </button>

            <a href="@(ViewBag.ReturnUrl ?? Url.Action(action: "Index"))"
                class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>

</div>