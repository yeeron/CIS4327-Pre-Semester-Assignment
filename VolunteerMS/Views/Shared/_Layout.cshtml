<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Volunteer MS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VolunteerMS.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Volunteer Management System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                     
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    📊 Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Volunteer" asp-action="Index">
                                    👥Volunteers
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Center" asp-action="Index">
                                    🏢 Centers
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="Skill"
                                asp-action="Index">
                                    🛠 Skills
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="Opportunities"
                                asp-action="Index">
                                    📅 Opportunities
                                </a>
                            </li>

                        </ul>

                        <div class="d-flex align-items-center gap-3">

                            <div class="text-end">
                                <div class="fw-semibold text-dark">
                                    Welcome, @User.Identity.Name
                                </div>
                            </div>

                            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm px-3">

                                <i class="bi bi-box-arrow-right"></i>
                                Logout

                            </a>

                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Notification" /> <!-- This line renders the _Notification partial view, which displays success and error messages stored in TempData. It checks if there are any messages and displays them in alert boxes accordingly.-->
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - VolunteerMS - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <!-- Include SweetAlert2 library -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
